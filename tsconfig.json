{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2023",
    "outDir": "out",
    "lib": ["ES2023", "dom", "dom.iterable", "webworker"],
    "sourceMap": true,
    "esModuleInterop": true, // added by tnaum to help with Denque integration, happy to discuss other approaches
    "allowSyntheticDefaultImports": true, // added by tnaum to fix SlickGrid integration, eager to discuss other approaches
    "noImplicitThis": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "noUnusedParameters": true,
    "rootDir": ".",
    "experimentalDecorators": true,
    "resolveJsonModule": true,
    "alwaysStrict": true,
    // Types only (bundlers and Vitest do not read `paths`). These packages declare types for their
    // `require` export but not for their `import` export, an untyped ESM wrapper around the same
    // CommonJS code, so `moduleResolution: Bundler` would type every import from them as `any`.
    "paths": {
      "@mongodb-js/explain-plan-helper": ["./node_modules/@mongodb-js/explain-plan-helper/dist/index.d.ts"],
      "mongodb-connection-string-url": ["./node_modules/mongodb-connection-string-url/lib/index.d.ts"]
    },
    "jsx": "react-jsx"
  },
  "exclude": ["node_modules", ".vscode-test", "packages/*/dist", "packages/*/scripts"],
  "references": [
    { "path": "packages/documentdb-js-schema-analyzer" },
    { "path": "packages/documentdb-js-operator-registry" },
    { "path": "packages/documentdb-js-shell-api-types" },
    { "path": "packages/documentdb-js-shell-runtime" },
    { "path": "packages/vscode-ext-webview" },
    { "path": "packages/vscode-ext-webview-fluentui" }
  ]
}
