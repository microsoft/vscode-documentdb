{
  "name": "@documentdb-js/connectivity-troubleshooter",
  "version": "0.1.0",
  "description": "Step-by-step connectivity checks for DocumentDB and MongoDB API connection strings",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "test": "vitest run --config ../../vitest.config.ts --project documentdb-js-connectivity-troubleshooter",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "prettier-fix": "prettier -w \"src/**/*.@(js|ts|jsx|tsx|json|md)\" \"./*.@(js|ts|jsx|tsx|json|md)\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/vscode-documentdb",
    "directory": "packages/documentdb-js-connectivity-troubleshooter"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@documentdb-js/srv-resolver": "^1.0.1",
    "bson": "^7.2.0",
    "mongodb-connection-string-url": "~3.0.2"
  }
}
