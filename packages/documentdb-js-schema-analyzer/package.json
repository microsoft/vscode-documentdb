{
  "name": "@documentdb-js/schema-analyzer",
  "version": "2.0.0",
  "description": "Incremental JSON Schema analyzer for DocumentDB API / MongoDB API documents with statistical extensions",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p .",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "test": "vitest run --config ../../vitest.config.ts --project documentdb-js-schema-analyzer"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/vscode-documentdb",
    "directory": "packages/documentdb-js-schema-analyzer"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "mongodb": ">=6.0.0"
  },
  "dependencies": {
    "denque": "~2.1.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
