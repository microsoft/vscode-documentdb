{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "compile",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always"
      },
      "problemMatcher": "$tsc-watch"
    },
    {
      "type": "npm",
      "script": "lint",
      "problemMatcher": "$eslint-stylish"
    },
    {
      "label": "Watch",
      "dependsOn": ["watch:ext", "watch:views"]
    },
    {
      "label": "watch:ext",
      "type": "npm",
      "script": "watch:ext",
      "group": "build",
      "isBackground": true,
      "problemMatcher": ["$ts-webpack-watch", "$tslint-webpack-watch"],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "new",
        "showReuseMessage": false,
        "clear": true,
        "group": "Cosmos DB Extension Watch"
      }
    },
    {
      "label": "watch:views",
      "type": "npm",
      "script": "watch:views",
      "group": "build",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^(?!)()()$",
          "kind": "file",
          "file": 1,
          "message": 2
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^> vite --config vite\\.config\\.views\\.mjs\\s*$",
          "endsPattern": "^\\s*VITE v\\d+\\.\\d+\\.\\d+\\s+ready in \\d+ ms\\s*$"
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "new",
        "showReuseMessage": false,
        "clear": true,
        "group": "Cosmos DB Extension Watch"
      }
    }
  ]
}
